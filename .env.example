# Local configuration for chora-observability.
# Copy to .env and fill in values. Never commit .env or secrets.

PORT=8080
CHORA_GRPC_PORT=9090

# Database. Leave unset for local in-memory repositories.
# CHORA_DB_DSN=postgres://USER:PASSWORD@HOST:5432/chora_observability?sslmode=disable
# CHORA_DB_DSN_SECRET_ID=

# Pub/Sub. For local Docker Compose these are overridden to the emulator.
# GOOGLE_CLOUD_PROJECT=chora-489812
# CHORA_PUBSUB_PROJECT=chora-489812
# PUBSUB_EMULATOR_HOST=localhost:8085

# GCP-only integrations. Existing deployments default both to enabled;
# local Compose overrides them to false.
CHORA_TRACING_ENABLED=false
CHORA_DECISION_BQ_ENABLED=false

# Runtime paths.
CHORA_PII_CLOSURE_MAP_PATH=config/PII_Closure_Map.yaml
CHORA_PRICING_CONFIG_PATH=config/pricing.yaml

# Optional explicit dotenv path. Normally the service auto-loads .env.
# CHORA_ENV_FILE=/absolute/path/to/.env

# Optional integrations.
# CHORA_EVAL_EVIDENCE_BQ=1
# CHORA_EVAL_BQ_PROJECT=chora-489812
CHORA_EVAL_BQ_DATASET=chora_observability_analytics
CHORA_EVAL_BQ_VIEW=agent_eval_evidence
CHORA_EVAL_BQ_LOCATION=asia-southeast1
# CHORA_DECISION_BQ_PROJECT=chora-489812
CHORA_DECISION_BQ_DATASET=chora_observability_analytics
CHORA_DECISION_BQ_TABLE=agent_decision_log
CHORA_DECISION_BQ_LOCATION=asia-southeast1
# CLOUDTRACE_OTLP_READ_ENDPOINT=
CLOUDTRACE_MOCK=0

# Reconciliation job.
GOOGLE_CLOUD_PROJECT=chora-489812
BIGQUERY_DATASET=chora_observability_analytics
RECONCILE_LOOKBACK_DAYS=1
RECONCILE_TOLERANCE_FRACTION=0.0001
BILLING_CLIENT_MODE=mock
# BILLING_API_KEY=
# RECONCILE_REQUIRE_PUBSUB=1
