# Local configuration for chora-observability.
# Copy to .env and fill in values. Never commit .env or secrets.

PORT=8080
CHORA_GRPC_PORT=9090

# Production-like/local Docker mode: refuse silent in-memory fallbacks.
CHORA_STRICT_STARTUP=true

# Database. Leave unset for local in-memory repositories.
# CHORA_DB_DSN=postgres://USER:PASSWORD@HOST:5432/chora_observability?sslmode=disable
# CHORA_DB_DSN_SECRET_ID=

# Event bus (NATS JetStream). Mandatory — the service refuses to start without it.
# NATS_URL=nats://127.0.0.1:4222

# Tracing. The local stack runs Grafana Tempo (OTLP ingest on tempo:4317,
# query API on tempo:3200). Set TEMPO_QUERY_URL to enable the Spanstore read
# routes (/api/traces/export + /api/v1/observability/spans); when unset those
# routes 503 honestly.
CHORA_TRACING_ENABLED=false
# TEMPO_QUERY_URL=http://tempo:3200

# Runtime paths.
CHORA_PII_CLOSURE_MAP_PATH=config/PII_Closure_Map.yaml
CHORA_PRICING_CONFIG_PATH=config/pricing.yaml

# Optional explicit dotenv path. Normally the service auto-loads .env.
# CHORA_ENV_FILE=/absolute/path/to/.env

# Source-project stamp on outbox envelopes.
CHORA_SOURCE_PROJECT=chora-local
